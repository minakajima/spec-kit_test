<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page Not Found - Phoenix Shooter</title>
    <style>
      body {
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        margin: 0;
        background: linear-gradient(135deg, #1e3a8a, #3730a3);
        color: white;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
      }
      .container {
        max-width: 500px;
        padding: 2rem;
      }
      h1 {
        font-size: 8rem;
        margin: 0;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
      }
      h2 {
        font-size: 2rem;
        margin: 1rem 0;
      }
      p {
        font-size: 1.2rem;
        margin: 1rem 0;
        opacity: 0.9;
      }
      a {
        color: #60a5fa;
        text-decoration: none;
        font-weight: bold;
      }
      a:hover {
        text-decoration: underline;
      }
      .game-link {
        display: inline-block;
        margin-top: 2rem;
        padding: 1rem 2rem;
        background: #ef4444;
        border-radius: 8px;
        transition: background 0.3s;
      }
      .game-link:hover {
        background: #dc2626;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>404</h1>
      <h2>Page Not Found</h2>
      <p>The page you are looking for doesn't exist.</p>
      <p>Maybe you'd like to play our <a href="/game">Phoenix Shooter Game</a> instead?</p>
      <a href="/game" class="game-link">Play Game</a>
    </div>
  </body>
</html>